{
  "name": "automation-machine-dashboard",
  "productName": "WIK Automation Machine Dashboard",
  "private": true,
  "version": "1.4.0",
  "description": "WIK Automation Machine Output Dashboard",
  "main": "electron.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "recharts": "^2.15.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.2.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.wik.automationmachinedashboard",
    "productName": "WIK Automation Machine Dashboard",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/automation-dashboard-backend.exe",
        "to": "backend/automation-dashboard-backend.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "WIK-Automation-Machine-Dashboard-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WIK Automation Machine Dashboard"
    }
  }
}
